<?xml version="1.0" encoding="UTF-8"?>
<events>
    <event id="200" name="Take off worn cloak" type="EVENT_TRIGGERED">
        <conditions>
            <condition type="checkCarrying" itemId="3"/>
        </conditions>
        <onSuccess>
            <consequence type="message">You remove the cloak.</consequence>
            <consequence type="removeItemsFromInventory" itemId="3"/>
            <consequence type="addItemsToInventory" itemId="2"/>
        </onSuccess>
        <onFailed>
            <consequence type="message">You're not wearing the cloak.</consequence>
        </onFailed>
    </event>
    
    <event id="201" name="Wear cloak" type="EVENT_TRIGGERED">
        <conditions>
            <condition type="checkCarrying" itemId="3" invert="true"/>
            <condition type="checkCarrying" itemId="2"/>
        </conditions>
        <onSuccess>
            <consequence type="removeItemsFromInventory" itemId="2"/>
            <consequence type="addItemsToInventory" itemId="3"/>
            <consequence type="message">OK</consequence>
        </onSuccess>
        <onFailed>
            <consequence type="message">Pick up the cloak first.</consequence>
        </onFailed>
    </event>
    
    <event id="202" name="Cloak picked up" type="EVENT_TRIGGERED">
        <conditions/>
        <onSuccess>
            <consequence type="updateItemDescription" itemIds="1">
                It's just a small brass hook, screwed to the wall.
            </consequence>
            <consequence type="addRoomTags" roomId="4" tags="dark"/>
        </onSuccess>
    </event>
	
    <event id="203" name="Read message" type="EVENT_TRIGGERED">
        <conditions/>
        <onSuccess>            
            <consequence type="showScore"/>
            <consequence type="waitForKey">...Press [Enter] to conrinue...</consequence>
            <consequence type="newGame"/>
        </onSuccess>
    </event>    
     
    <event id="204" name="Examine message" type="EVENT_TRIGGERED">
        <conditions>
            <condition type="checkRoomHasTag" tags="dark"/>
        </conditions>
        <onSuccess>            
            <consequence type="updateItemDescription" itemId="4">
                The message has mostly been trodden out but you can still see it reads...

                *** You have lost ***
            </consequence>
        </onSuccess>
        <onFailed>
            <consequence type="fireEvent" eventId="203"/>
        </onFailed>
    </event>
    
    <event id="500000" name="Death" type="EVENT_TRIGGERED">
        <conditions/>
        <onSuccess>
            <consequence type="message">
                Darkness descends. 
            </consequence>
            <consequence type="waitForKey">...Press [Enter] to continue...</consequence>
            <consequence type="newGame"/>
        </onSuccess>
    </event>
    
    <event id="20000" type="EVENT_TRIGGERED">
        <conditions>
            <condition type="checkCount" key="barBumps" amount="2" invert="true"/>
        </conditions>
        <onSuccess>            
            <consequence type="points" key="barBumps" amount="1"/>      
        </onSuccess>
        <onFailed>
            <consequence type="updateItemDescription" itemId="4">
                The message has mostly been trodden out but you can still see it reads...

                *** You have lost ***
            </consequence>
        </onFailed>
    </event>
    
    <event id="20001" type="EVENT_TRIGGERED">
        <conditions>
            <condition type="checkCount" key="barBumps" amount="2" invert="true"/>
        </conditions>
        <onSuccess>
            <consequence type="points" key="barBumps" amount="1"/>
            <consequence type="message">You fumble around in the dark.</consequence>
            <consequence type="blockAction"/>         
        </onSuccess>
        <onFailed>
            <consequence type="updateItemDescription" itemId="4">
                The message has mostly been trodden out but you can still see it reads...

                *** You have lost ***
            </consequence>
            <consequence type="message">You fumble in the dark.</consequence>
            <consequence type="blockAction"/> 
        </onFailed>
    </event>
</events>

